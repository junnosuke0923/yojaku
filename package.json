{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "verify:layout": "esbuild test/verify-layout.ts --bundle --platform=node --format=esm --outfile=test/verify-layout.mjs --log-level=warning && node test/verify-layout.mjs",
    "verify": "esbuild test/verify.ts --bundle --platform=node --format=esm --outfile=test/verify.mjs --log-level=warning && node test/verify.mjs",
    "sample": "esbuild test/make-sample.ts --bundle --platform=node --format=esm --outfile=test/make-sample.mjs --log-level=warning && node test/make-sample.mjs",
    "deploy": "npm run verify:layout && npm run build && node scripts/deploy.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "esbuild": "^0.28.2",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
